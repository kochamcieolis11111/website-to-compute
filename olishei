<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Kocie Forum</title>
  <!-- KaTeX do formuł -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"
          onload="renderMathInElement(document.body);"></script>

  <!-- Firebase -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"></script>

  <style>
    body { font-family: Arial; text-align: center; background: #ffe0f5; color: #333; }
    h1 { color: #ff66aa; }
    textarea, input { width: 300px; margin: 5px; padding: 5px; }
    #posts { margin-top: 20px; }
    .post { border: 1px solid #ff99cc; background: #fff0f5; padding: 10px; margin: 10px auto; width: 320px; text-align: left; }
    .post img { max-width: 300px; margin-top: 5px; display:block; }
    button { padding: 5px 10px; background: #ff66aa; color: white; border: none; cursor: pointer; }
    button:hover { background: #ff3399; }
    .img-container { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; }
    .img-container div { text-align: center; }
  </style>
</head>
<body>
  <h1>Kocie Forum & Anime Girl</h1>

  <div class="img-container">
    <div>
      <img src="https://i.imgur.com/3rJj0fj.png" alt="Pixel Kitty">
      <p>Łapek</p>
    </div>
    <div>
      <img src="https://i.imgur.com/8wqkNfR.png" alt="Anime Girl">
      <p>Anime Girl</p>
    </div>
  </div>

  <h2>Dodaj komentarz (wymagane hasło)</h2>
  <input type="text" id="nick" placeholder="Twój nick"><br>
  <input type="text" id="imgURL" placeholder="URL obrazka"><br>
  <textarea id="comment" placeholder="Twój komentarz"></textarea><br>
  <input type="password" id="password" placeholder="Hasło">
  <button onclick="addComment()">Dodaj komentarz</button>

  <h2>Wpisz formułę LaTeX</h2>
  <textarea id="formulaInput" placeholder="np. E=mc^2"></textarea><br>
  <button onclick="showFormula()">Pokaż formułę</button>
  <div id="formulaDisplay"></div>

  <h2>Komentarze publiczne</h2>
  <div id="posts"></div>

  <script>
    // ====== KONFIGURACJA FIREBASE ======
    const firebaseConfig = {
      apiKey: "TU_WKLEJ_SWÓJ_API_KEY",
      authDomain: "TU_WKLEJ_PROJEKT.firebaseapp.com",
      projectId: "TU_WKLEJ_PROJEKT",
      storageBucket: "TU_WKLEJ_PROJEKT.appspot.com",
      messagingSenderId: "TU_WKLEJ_SENDER_ID",
      appId: "TU_WKLEJ_APP_ID"
    };
    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    const allowedPasswords = ["kochamcieolis", "jaciebietezmaia"];

    // ====== DODAWANIE KOMENTARZA ======
    async function addComment() {
      const nick = document.getElementById("nick").value || "Anon";
      const text = document.getElementById("comment").value;
      const img = document.getElementById("imgURL").value;
      const pass = document.getElementById("password").value;

      if (!allowedPasswords.includes(pass)) {
        alert("Nieprawidłowe hasło!");
        return;
      }
      if (!text && !img) {
        alert("Wpisz komentarz lub wklej obrazek!");
        return;
      }

      await db.collection('comments').add({nick, text, img, date: Date.now()});
      loadComments();

      document.getElementById("nick").value = "";
      document.getElementById("comment").value = "";
      document.getElementById("imgURL").value = "";
      document.getElementById("password").value = "";
    }

    // ====== POBIERANIE KOMENTARZY ======
    async function loadComments() {
      const snapshot = await db.collection('comments').orderBy('date').get();
      const posts = snapshot.docs.map(doc => doc.data());
      const postsDiv = document.getElementById("posts");
      postsDiv.innerHTML = "";
      posts.forEach(post => {
        postsDiv.innerHTML += `<div class="post"><strong>${post.nick}</strong>: ${post.text}` +
                              (post.img ? `<br><img src="${post.img}">` : "") +
                              `</div>`;
      });
    }

    // ====== FORMUŁA LATEX ======
    function showFormula() {
      const formula = document.getElementById("formulaInput").value;
      const display = document.getElementById("formulaDisplay");
      display.innerHTML = "$$" + formula + "$$";
      renderMathInElement(display);
    }

    loadComments();
  </script>
</body>
</html>
